# OCC final-runtime network configuration template.
#
# Copy this file to one of the supported runtime locations,
# preferably:
#
#   /etc/occ-final-runtime/network.env
#
# Fill these values for the deployment.
# Do not commit live IP addresses, hostnames, credentials, or keys.

# Logical OCC service identity.
OCC_SERVICE_NAME=

# TLS certificate/server identity.
# This is intentionally independent from the routable endpoint.
OCC_TLS_SERVER_NAME=

# Routable OCC endpoint used by the gateway.
# May be a WireGuard address, DNS name, or another reachable address.
OCC_GATEWAY_TARGET=

# Remote OCC machine used by the top-level system launcher.
# Host defaults to OCC_GATEWAY_TARGET when left empty.
OCC_REMOTE_HOST=
OCC_REMOTE_USER=

# Protocol ports are architecture-level defaults and may be overridden.
OCC_MQTT_C0_PORT=1883
OCC_MQTT_C1_PORT=1884
OCC_MQTT_C2_PORT=8883
OCC_DASHBOARD_PORT=8080
