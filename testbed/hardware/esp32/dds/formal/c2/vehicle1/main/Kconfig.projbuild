menu "FAIR-V1 Formal DDS Vehicle 1"
config FAIR_WIFI_SSID
    string "Wi-Fi SSID"
    default ""
config FAIR_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""
config FAIR_DDS_AGENT_IP
    string "Micro XRCE-DDS Agent IPv4 address"
    default ""
config FAIR_DDS_AGENT_PORT
    string "Micro XRCE-DDS Agent UDP port"
    default "8888"
config FAIR_RUN_ID
    string "FAIR run ID"
    default ""
config FAIR_REPEAT_INDEX
    int "FAIR repeat index"
    range 1 5
    default 1
config FAIR_WORKLOAD_SPEED
    string "FAIR workload speed"
    default ""
config FAIR_WORKLOAD_POS_X
    string "FAIR workload pos_x"
    default ""
config FAIR_WORKLOAD_POS_Y
    string "FAIR workload pos_y"
    default ""
config FAIR_WORKLOAD_HEADING
    string "FAIR workload heading"
    default ""
config FAIR_WORKLOAD_BATTERY_PCT
    string "FAIR workload battery_pct"
    default ""
config FAIR_WORKLOAD_STATE
    string "FAIR workload state"
    default ""
endmenu


config FAIR_DDS_DOMAIN_ID
    int "Native DDS Domain ID"
    range 0 232
    default 2
    help
        DDS domain used by the C2 XRCE participant.
        Use domain 2 to isolate C2 from C0/C1 domain 0.
