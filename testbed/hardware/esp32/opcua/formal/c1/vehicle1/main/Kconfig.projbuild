    default 1

config FAIR_WORKLOAD_SPEED
    string "FAIR workload speed"
    default ""

config FAIR_WORKLOAD_POS_X
    string "FAIR workload pos_x"
    default ""

config FAIR_WORKLOAD_POS_Y
    string "FAIR workload pos_y"
    default ""

config FAIR_WORKLOAD_HEADING
    string "FAIR workload heading"
    default ""

config FAIR_WORKLOAD_BATTERY_PCT
    string "FAIR workload battery_pct"
    default ""

config FAIR_WORKLOAD_STATE
    string "FAIR workload state"
    default ""

