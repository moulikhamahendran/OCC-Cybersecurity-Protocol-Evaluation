    string "SNTP server for secure profiles"
    default ""

config FAIR_OPCUA_ENDPOINT
    string "Formal OPC UA endpoint URL"
    default ""

config FAIR_OPCUA_USERNAME
    string "OPC UA username"
    default ""

config FAIR_OPCUA_PASSWORD
    string "OPC UA password"
    default ""

config FAIR_RUN_ID
    string "FAIR run ID"
    default ""

config FAIR_REPEAT_INDEX
    int "FAIR repeat index"
