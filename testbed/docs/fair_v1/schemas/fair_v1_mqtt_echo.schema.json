{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fair-v1:schema:mqtt-echo:1.0",
  "title": "FAIR-V1 MQTT Echo",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "serialNumber",
    "seq"
  ],
  "properties": {
    "serialNumber": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 599
    }
  }
}
