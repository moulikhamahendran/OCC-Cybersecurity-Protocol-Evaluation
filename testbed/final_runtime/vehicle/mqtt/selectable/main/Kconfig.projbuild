menu "OCC MQTT Selectable Runtime"

config OCC_MQTT_DEFAULT_PROFILE
    string "Default MQTT security profile"
    default "C2"
    help
        Initial profile used when no runtime profile exists in NVS.
        Valid values: C0, C1, C2.

config OCC_DEFAULT_HOST
    string "Bootstrap OCC host"
    default "occ-pi.local"
    help
        Used only when no runtime OCC endpoint exists in NVS.
        Runtime endpoint configuration overrides this value.

config OCC_TLS_SERVER_NAME
    string "C2 TLS server identity"
    default "occ-pi.local"
    help
        Certificate identity used for C2 verification.
        Routing destination and TLS identity are intentionally
        separate.

config OCC_SNTP_PRIMARY_SERVER
    string "Primary SNTP server for C2 TLS certificate validation"
    default "pool.ntp.org"
    help
        Network-independent time source used first when Internet
        connectivity is available.

config OCC_SNTP_SERVER
    string "Fallback local SNTP server for C2 TLS certificate validation"
    default "occ-pi.local"
    help
        Local OCC time source used when the primary SNTP server
        is unavailable.

config OCC_VEHICLE_ID
    string "Vehicle identity"
    default "VM-001"

config OCC_RUNTIME_PERIOD_MS
    int "Operational telemetry period in milliseconds"
    range 50 60000
    default 100
    help
        100 ms = 10 Hz.
        Operational runtime only; does not change the frozen FAIR benchmark.

endmenu
