[Unit]
Description=OCC Cybersecurity Dashboard
After=network-online.target mosquitto.service occ-mqtt.service
Wants=network-online.target occ-mqtt.service
Requires=mosquitto.service

[Service]
Type=simple
User=occ-runtime
Group=occ-runtime

WorkingDirectory=/opt/occ-dashboard

Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

Environment=OCC_DASHBOARD_MQTT_ENABLED=1
Environment=OCC_DASHBOARD_MQTT_CONTROL_ENABLED=1
Environment=OCC_DASHBOARD_RUNTIME_CONFIG=/etc/occ-final-runtime/system.json
Environment=OCC_DASHBOARD_STATIC_DIR=/opt/occ-dashboard/static

EnvironmentFile=-/etc/occ-final-runtime/mqtt.env

Environment=OCC_DASHBOARD_BIND_HOST=0.0.0.0
Environment=OCC_DASHBOARD_PORT=8080
EnvironmentFile=-/etc/occ-final-runtime/dashboard.env

ExecStart=/opt/occ-dashboard/.venv/bin/python \
    -m uvicorn \
    testbed.backend.main:app \
    --host ${OCC_DASHBOARD_BIND_HOST} \
    --port ${OCC_DASHBOARD_PORT}

Restart=always
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
