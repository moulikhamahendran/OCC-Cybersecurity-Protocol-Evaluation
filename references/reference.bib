@article{lin_blockchain-based_2025,
	title = {Blockchain-based shop floor control system for small and medium-sized enterprise evolution to industry 4.0},
	volume = {15},
	issn = {2045-2322},
	url = {https://doi.org/10.1038/s41598-025-13809-3},
	doi = {10.1038/s41598-025-13809-3},
	abstract = {Small and medium-sized enterprises (SMEs) require agile and robust strategies to navigate the difficulties of their evolution toward Industry 4.0. This study proposes a Blockchain-based Shop Floor Control System (BSFCS) that incorporates a Consensus-based Workflow Change Integration (CWCI) mechanism and Smart Contract Service (SCS) design methodology to provide these strategies. The CWCI represents an incremental agile approach, enabling real-time workflow adjustments and smooth, rapid integration of evolving enterprise requirements. The modular architecture and optimized key-state data structures that are features of the SCS design methodology support efficient transaction management, ensuring system feasibility. A prototype implementing the BSFCS was tested on a realistic industrial platform replicating real-world manufacturing conditions. Results from two validation experiments demonstrate significant performance improvements over a standard model. These enhancements include dynamic workflow adaptability, enhanced operational transparency, and efficient handling of real-time changes. These BSFCS characteristics represent requirements SMEs need for a reliable and sequential pathway they can follow implementing Industry 4.0. They show that compared to existing frameworks, the BSFCS framework we propose offers superior adaptability and scalability. It particularly excels in handling dynamic workflow changes and sequential upgrades with minimal disruption to ongoing operations.},
	language = {en},
	number = {1},
	urldate = {2026-04-29},
	journal = {Scientific Reports},
	author = {Lin, Chin-Te},
	month = aug,
	year = {2025},
	keywords = {Blockchain, Digital thread, Hyperledger fabric, Industry 4.0, Shop floor management, Small and medium-sized enterprises, Smart contract},
	pages = {28601},
}

@article{homaei_review_2024,
	title = {A review of digital twins and their application in cybersecurity based on artificial intelligence},
	volume = {57},
	issn = {1573-7462},
	url = {https://doi.org/10.1007/s10462-024-10805-3},
	doi = {10.1007/s10462-024-10805-3},
	abstract = {The potential of digital twin technology is yet to be fully realised due to its diversity and untapped potential. Digital twins enable systems’ analysis, design, optimisation, and evolution to be performed digitally or in conjunction with a cyber-physical approach to improve speed, accuracy, and efficiency over traditional engineering methods. Industry 4.0, factories of the future, and digital twins continue to benefit from the technology and provide enhanced efficiency within existing systems. Due to the lack of information and security standards associated with the transition to cyber digitisation, cybercriminals have been able to take advantage of the situation. Access to a digital twin of a product or service is equivalent to threatening the entire collection. There is a robust interaction between digital twins and artificial intelligence tools, which leads to strong interaction between these technologies, so it can be used to improve the cybersecurity of these digital platforms based on their integration with these technologies. This study aims to investigate the role of artificial intelligence in providing cybersecurity for digital twin versions of various industries, as well as the risks associated with these versions. In addition, this research serves as a road map for researchers and others interested in cybersecurity and digital security.},
	language = {en},
	number = {8},
	urldate = {2026-04-29},
	journal = {Artificial Intelligence Review},
	author = {Homaei, Mohammadhossein and Mogollón-Gutiérrez, Óscar and Sancho, José Carlos and Ávila, Mar and Caro, Andrés},
	month = jul,
	year = {2024},
	keywords = {Artificial intelligence, Cybersecurity, Digital twin, Industry 4.0, Internet of things},
	pages = {201},
}

@article{das_performance_2025,
	title = {Performance evaluation of mobile robotic system for monitoring and inspection using {MQTT} protocol and {IoT} technique},
	volume = {9},
	issn = {2366-598X},
	url = {https://doi.org/10.1007/s41315-025-00465-z},
	doi = {10.1007/s41315-025-00465-z},
	abstract = {This paper proposes a novel approach for developing a mobile robotic system-based monitoring and inspection using MQTT protocol and Internet-of-thing (IoT) technique. To develop such new features in a mobile robotic system, an android/web-based application along with MQTT protocol and IoT technique is applied to carry out the robotic autonomous tasks wirelessly which can be helpful in a variety of fields like industrial, inspection, power plant, oil and gas, mining, medical, mining, societal, agriculture, etc. By combining the MQTT protocol and IoT technique, a novel communication design methodology for mobile robotic systems for monitoring and inspection is proposed to understand the functionality and control of the sensor and actuators process, and its visualization capabilities using wireless cameras for industrial applications like inspection of pipelines, tunnels, etc. A NodeMCU microcontroller is used which has an inbuilt ESP8266 chip for communication wirelessly. An MQTT protocol provides a single publisher in the cloud using IoT to enhance communication capabilities. A prototype of the mobile robotic system is established and network signal strength is analyzed. The performance of the mobile robot is evaluated using the MQTT protocol. It is envisaged that the MQTT protocol obtained faster communication in wireless communication than the HTTP protocol in IoT technology. Hence, the data can be saved in the IoT cloud in a faster manner for evaluating the performance of mobile robotic systems towards predictions of the life of pipelines which recommends a new generation of robotic systems.},
	language = {en},
	number = {4},
	urldate = {2026-04-29},
	journal = {International Journal of Intelligent Robotics and Applications},
	author = {Das, Amitava and Jain, Ravi Kant},
	month = dec,
	year = {2025},
	keywords = {Cloud computing etc., Communication protocols, IoT, MQTT, Mobile robotic system},
	pages = {1302--1330},
}

@article{solanki_novel_2025,
	title = {A novel intrusion detection framework using ensemble learning in {MQTT} {IoT} applications},
	issn = {1573-7470},
	url = {https://doi.org/10.1007/s10472-025-09993-7},
	doi = {10.1007/s10472-025-09993-7},
	abstract = {The Internet of Things (IoT) ecosystem increasingly relies on the Message Queuing and Telemetry Transport (MQTT) protocol due to its lightweight and efficient communication capabilities. However, MQTT-enabled networks are vulnerable to various security threats, including eavesdropping, weak authentication, and malicious payload injections. Detecting such intrusions is particularly challenging in IoT environments because of constrained resources, high traffic volumes, and heterogeneous attack vectors. To address these challenges, this study proposes an ensemble learning-based Intrusion Detection System (IDS) specifically designed for MQTT-enabled IoT networks. The ensemble integrates Gaussian Naive Bayes (GNB), Kernel-based Support Vector Machines (K-SVM), and Multi-Layer Perceptrons (MLP) as base classifiers, with Logistic Regression serving as the meta-classifier. Among these, MLP plays a pivotal role by leveraging its deep learning capabilities and parallel processing strengths to capture complex, nonlinear attack patterns that are often missed by conventional models. The combination of diverse classifiers in a stacked architecture significantly enhances the system’s precision, scalability, and adaptability. Experimental evaluation of binary and multi-class classification tasks using the MQTT-IoT-IDS2020 dataset demonstrate that the proposed model achieves outstanding detection accuracies of 99.80\% and 99.59\%, respectively, outperforming traditional machine learning and standalone deep learning approaches. These results highlighted the effectiveness of the ensemble framework, particularly the critical contribution of MLP, in building a robust, high-performance, and scalable intrusion detection solution for secure IoT communications.},
	language = {en},
	urldate = {2026-04-29},
	journal = {Annals of Mathematics and Artificial Intelligence},
	author = {Solanki, Mitesh and Gupta, Shilpi},
	month = jul,
	year = {2025},
	keywords = {Cyberattacks, Ensemble Learning Framework, Gaussian Naive Bayes (GNB), Intrusion Detection System (IDS), IoT Security, Kernel Support Vector Machine (K-SVM), MQTT Protocol Security, Multi-Layer Perceptron (MLP)},
}

@inproceedings{soto_adaptive_2025,
	title = {Adaptive {Cybersecurity} for {Industrial} {Environments} {Using} {Evolutionary} {Algorithms}: {A} {Methodological} {Proposal}},
	shorttitle = {Adaptive {Cybersecurity} for {Industrial} {Environments} {Using} {Evolutionary} {Algorithms}},
	url = {https://ieeexplore.ieee.org/document/11311918/},
	doi = {10.1109/ENC68268.2025.11311918},
	abstract = {The increasing digitalization of industrial processes under Industry 4.0 has significantly expanded the attack surface of critical infrastructures, making traditional static-rule cybersecurity approaches insufficient to counter emerging and dynamic threats. This paper presents a structured methodological framework for developing an adaptive cybersecurity system based on evolutionary algorithms. The proposed methodology integrates six progressive phases: data collection from simulated IIoT and SCADA environments using NADAGEN, GothX, and TRex; preprocessing through normalization and evolutionary feature selection; evolutionary modeling with GA, PSO, and DE; adaptive optimization through self-adjusting parameters; and validation in simulated industrial networks using Modbus/TCP, MQTT, and OPC-UA protocols. A detailed data-flow diagram and pseudocode illustrate the iterative process of rule generation, evaluation, and improvement. Expected results include higher detection accuracy, reduced false positives, faster response time, and improved resilience against zero-day attacks. The proposal establishes a replicable foundation for designing intelligent, scalable, and self-learning intrusion detection systems capable of adapting to evolving cyber threats in Industry 4.0 environments.},
	urldate = {2026-04-29},
	booktitle = {2025 {Mexican} {International} {Conference} on {Computer} {Science} ({ENC})},
	author = {Soto, J. E. Soto and Hernández-Vega, J.I. and Gómez-Sánchez, L. E. and Reynoso-Guajardo, L. A. and Hernández-Santos, C. and Alonzo-Garcia, A. and Jimenez-Vielma, J. F. and Silva-Trujillo, A. G.},
	month = nov,
	year = {2025},
	note = {ISSN: 2332-5712},
	keywords = {Adaptive systems, Computer security, Evolutionary computation, Fourth Industrial Revolution, Industrial cybersecurity, Industry 4.0, Intrusion detection, Proposals, Protocols, Resilience, Surface treatment, Time factors, adaptive systems, evolutionary algorithms, intrusion detection},
	pages = {1--6},
}

@inproceedings{hua_high-efficiency_2024,
	title = {A {High}-{Efficiency} {Distributed} {System} for {Real}-{Time} {High}-{Frequency} {Data} {Interaction} in {Secure} {Power} {Zones} of {Substations}},
	url = {https://ieeexplore.ieee.org/document/10898836/},
	doi = {10.1109/ICEACE63551.2024.10898836},
	abstract = {This paper presents an efficient distributed system for real-time data interaction within the safety zone of a substation. The system utilizes state-of-the-art sensors and Supervisory Control and Data Acquisition (SCADA) systems that can efficiently collect, cleanse, and organize high-frequency data, thereby addressing the challenges of traditional centralized approaches to data management. The system enhances reliability and scalability in handling large data streams by using Support Vector Machine (SVM) algorithms for data classification and Isolated Forest Models for anomaly detection. The system combines the MQTT protocol with the IEC 61850 standard to achieve secure and synchronized data exchange, which further enhances real-time response capability and data security. The system architecture reduces latency and improves scalability by decentralizing data processing, and reduces the risk of a single point of failure, making it resilient against cyber threats. Performance evaluations show that the system provides reliability in data monitoring, enhances fault detection capabilities, and facilitates proactive maintenance of substations.},
	urldate = {2026-04-29},
	booktitle = {2024 {IEEE} 2nd {International} {Conference} on {Electrical}, {Automation} and {Computer} {Engineering} ({ICEACE})},
	author = {Hua, Jie and Li, Wei and Xu, Chuan and Feng, Chenghao},
	month = dec,
	year = {2024},
	keywords = {Anomaly Detection, Data aggregation, Distributed Data Parsing, Distributed databases, Feature extraction, MQTT Protocol, Protocols, Real-Time Data interaction, Real-time systems, SCADA systems, Safety, Scalability, Standards, Substations, Support vector machines, Synchronization},
	pages = {237--243},
}

@inproceedings{pawar_plc_2025,
	title = {{PLC} {Diagnosis} and {Monitoring} {System}},
	url = {https://ieeexplore.ieee.org/document/11005035/},
	doi = {10.1109/ICICT64420.2025.11005035},
	abstract = {Programmable Logic Controllers (PLCs) are essential to industrial automation, where real-time diagnostics are critical in preventing faults and ensuring operational resilience. This paper presents an IoT-based PLC Diagnosis System that monitors critical parameters voltage, current, temperature, humidity, and vibration using an ESP32 microcontroller, various sensors, and an I2C LCD. The system transmits sensor data over MQTT and visualizes this in a Node-RED dashboard; alerts trigger LEDs and buzzer with threshold exceedance. With usercontrolled display modes, the segmented gauge allows continuous PLC diagnostics. The remote access and data storage that it allows through MongoDB integration are useful for timely interventions. Experimental results confirm the system's efficiency and affordability in real-time PLC diagnostics of industrial applications.},
	urldate = {2026-04-29},
	booktitle = {2025 {International} {Conference} on {Inventive} {Computation} {Technologies} ({ICICT})},
