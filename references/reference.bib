	keywords = {Computer architecture, Data analysis, Employment, Fourth Industrial Revolution, Logic gates, Monitoring, Protocols, Reliability, Security, Servers, Standards, automated workplace, industry 4.0/5.0, monitoring of the processes, open platform communication unified architecture (OPC UA)},
	pages = {51069--51084},
}

@inproceedings{altschaffel_network-based_2024,
	title = {Network-{Based} {Ransomware} - {A} {New} {Threat} {Demonstrated} on the {Example} of {Industrial} {Control} {Systems}},
	url = {https://ieeexplore.ieee.org/document/10603018/},
	doi = {10.1109/INTCEC61833.2024.10603018},
	abstract = {Ransomware is known to take control of data. This paper introduces and explores the novel threat of network ransomware which targets the network between computers. This paper demonstrates this threat on the example of Industrial Control Systems (ICS). In order to describe this novel threat, the Threat Landscape for Ransomware Attacks taxonomy from the European Union Agency for Cybersecurity (ENISA) is extended by the assets - Network and Device - as well as one action - Alter. The original four ENISA actions Lock, Encrypt, Delete and Steal and the additional action Alter are described in this extended taxonomy and demonstrated within an ICS environment in two Evaluation Cases (EC) including the network protocols Modbus/TCP and OPC UA as well as one complex scenario of network based ransomware within ICS involving 3 sensors, 5 actuators, 2 PLCs and 1 Historian using the OPC UA protocol.},
